{
  "llvm-target": "armv6k-unknown-none-eabihf",
  "cpu": "mpcore",
  "features": "+armv6k,+dsp,+fp64,+strict-align,+vfp2,+vfp2sp,-thumb-mode",
  "build-tags": ["nintendo3ds", "arm"],
  "scheduler": "tasks",
  "goos": "linux",
  "goarch": "arm",
  "linker": "ld.lld",
  "rtlib": "",
  "libc": "",
  "gc": "precise",
  "default-stack-size": 131072,
  "cflags": [
    "-target", "armv6k-unknown-none-eabihf",
    "-mcpu=mpcore",
    "-mfloat-abi=hard",
    "-mfpu=vfpv2",
    "-mtp=soft",
    "-D__3DS__",
    "-isystem", "{devkitpro}/devkitARM/arm-none-eabi/include",
    "-I{devkitpro}/libctru/include",
    "-Werror",
    "-fshort-enums",
    "-fno-exceptions", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
    "-ffunction-sections", "-fdata-sections"
  ],
  "ldflags": [
    "--defsym=__sync_synchronize=__sync_synchronize_dmb",
    "--emit-relocs",
    "--gc-sections",
    "-L{devkitpro}/libctru/lib",
    "-L{devkitarm-gcc}/armv6k/fpu",
    "-L{devkitpro}/devkitARM/arm-none-eabi/lib/armv6k/fpu",
    "{devkitpro}/devkitARM/arm-none-eabi/lib/armv6k/fpu/3dsx_crt0.o",
    "{devkitarm-gcc}/armv6k/fpu/crti.o",
    "{devkitarm-gcc}/armv6k/fpu/crtbegin.o",
    "-lctru", "-lm",
    "--start-group", "-lgcc", "-lc", "-lsysbase", "--end-group",
    "{devkitarm-gcc}/armv6k/fpu/crtend.o",
    "{devkitarm-gcc}/armv6k/fpu/crtn.o"
  ],
  "linkerscript": "targets/nintendo3ds.ld",
  "extra-files": [
    "src/runtime/asm_arm.S",
    "src/internal/task/task_stack_nintendo3ds.S",
    "src/runtime/runtime_nintendo3ds.c"
  ]
}
